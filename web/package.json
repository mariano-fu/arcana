{
  "name": "arcana-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-precache.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "gen:api-types": "openapi-typescript ../api/openapi.yaml -o src/sync/api.gen.ts",
    "generate-pwa-assets": "pwa-assets-generator",
    "build:cards-review": "node scripts/build-cards-review.ts",
    "build:spreads-review": "node scripts/build-spreads-review.ts",
    "build:crystals-review": "node scripts/build-crystals-review.ts",
    "build:card-images": "node scripts/build-card-images.ts",
    "build:cities": "node scripts/build-cities.ts",
    "fetch:horizons-reference": "node scripts/fetch-horizons-reference.ts"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "i18next": "^26.5.2",
    "luxon": "^3.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router": "^8.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
