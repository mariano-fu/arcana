# Copy to api/.env for local development. Real environment variables win over this file.
# Required when DEBUG is off: generate with
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://<host>.<tailnet>.ts.net in production
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana
DB_CONN_MAX_AGE=60
LOG_LEVEL=INFO
# Login and token refresh, each (DRF rate syntax: N/sec|min|hour|day)
AUTH_THROTTLE_RATE=10/min
