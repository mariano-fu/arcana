# Copy to deploy/.env (gitignored) and fill in. Never commit .env.
# Placeholders below; real host names stay out of the repo.

# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# openssl rand -hex 32   (hex, so it needs no escaping inside DATABASE_URL)
POSTGRES_PASSWORD=

# The tailnet name tailscale serve answers on, and localhost for the admin over an SSH tunnel.
ALLOWED_HOSTS=<host>.<tailnet>.ts.net,localhost
CSRF_TRUSTED_ORIGINS=https://<host>.<tailnet>.ts.net

# Proxies in front of gunicorn: tailscale serve → Caddy.
NUM_PROXIES=2
AUTH_THROTTLE_RATE=10/min
LOG_LEVEL=INFO

# Host loopback ports: tailscale serve → CADDY_PORT; the opt-in admin service
# (--profile admin, for an SSH tunnel; stop it when done) → ADMIN_PORT.
CADDY_PORT=8080
ADMIN_PORT=8001
# The external volume holding the database (create it once: docker volume create <name>).
PGDATA_VOLUME=arcana_pgdata
